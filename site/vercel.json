{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": {
    "silent": true
  },
  "redirects": [
    { "source": "/", "destination": "https://github.com/Schniz/fnm" }
  ],
  "rewrites": [
    { "source": "/install", "destination": "/install.txt" },
    { "source": "/install.ps1", "destination": "/install-ps1.txt" }
  ],
  "headers": [
    {
      "source": "/install",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/install.ps1",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
